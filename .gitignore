# Allowlist: only source, required assets, build files and maintenance scripts.
# Local environments, instances, logs, screenshots, reports and release archives stay out.
/*
!/.gitignore
!/README.md
!/LICENSE
!/TEMPLATE_LICENSE.txt
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat

!/gradle/
/gradle/**
!/gradle/wrapper/
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

!/src/
/src/**
!/src/**/
!/src/**/*.java
!/src/**/*.json
!/src/**/*.png
!/src/**/*.toml

!/tools/
/tools/*
!/tools/bootstrap.py
!/tools/gradle.ps1
!/tools/generate_assets.py
!/tools/check_resources.py
!/tools/run_runtime.py
!/tools/package_release.py

# Generated files must remain ignored even if created below a source directory.
**/__pycache__/
**/.cache/
**/*.class
**/*.log
**/*.hprof
**/*.tmp
**/*.bak
