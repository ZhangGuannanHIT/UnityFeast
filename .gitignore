# Allowlist: source code and game resources, plus README and required license notices.
# Build configuration, Wrapper, tools, caches, instances and release artifacts stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/TEMPLATE_LICENSE.txt
!/src/
/src/**
!/src/**/
!/src/**/*.java
!/src/**/*.json
!/src/**/*.png
!/src/**/*.toml

# Generated files must remain ignored even if created below a source directory.
**/__pycache__/
**/.cache/
**/*.class
**/*.log
**/*.hprof
**/*.tmp
**/*.bak
